# API Configuration
# Backend base URL including the /api prefix, e.g. https://api.aventix.co.in/api (local: http://127.0.0.1:8000/api)
VITE_API_URL=https://api.example.com

# Analytics (optional)
VITE_GOOGLE_ANALYTICS_ID=
VITE_ANALYTICS_ENABLED=false

# Feature Flags
VITE_ENABLE_BETA_FEATURES=false
